---
import '../styles/global.css';

interface Props {
  title?: string;
  heading?: string;
}

const { title = 'Marketing', heading = 'Marketing' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-stone-900">
    <header class="border-b border-stone-200 px-8 py-4">
      <h1 class="text-xl font-semibold">{heading}</h1>
    </header>
    <div class="flex gap-8 px-8 py-8">
      <main class="flex-1">
        <slot />
      </main>
      <aside class="w-64 shrink-0 border-l border-stone-200 pl-8">
        <slot name="sidebar" />
      </aside>
    </div>
    <footer class="border-t border-stone-200 px-8 py-6 text-sm text-stone-500">
      © Marketing layout
    </footer>
    <script is:inline src="/scripts/bridge.js"></script>
  </body>
</html>
