---
/**
 * @category Logos
 * @theme classic
 * @name Logos5
 */
---
<section
  class='py-16 px-16 grid grid-cols-12 gap-8 h-min bg-stone-50 overflow-hidden'
>
  <div class='col-start-1 col-end-13'>
    <h2
      class='w-full text-center text-2xl font-semibold text-gray-800'
    >
      Helping the world's leading companies
    </h2>
    <p
      class='w-full text-center text-xl text-gray-500'
    >
      From next-gen startups to established enterprises
    </p>
    <div class='w-full gap-8 mt-4 whitespace-nowrap'>
      <div class='w-max animate-slide flex flex-row'>
        <img src='/assets/logos/Coastline.svg' alt='Coastline' class='w-1/6 h-auto' />
        <img src='/assets/logos/Kettle.svg' alt='Kettle' class='w-1/6 h-auto' />
        <img src='/assets/logos/Nordvik.svg' alt='Nordvik' class='w-1/6 h-auto' />
        <img src='/assets/logos/Halden.svg' alt='Halden' class='w-1/6 h-auto' />
        <img src='/assets/logos/Lumen.svg' alt='Lumen' class='w-1/6 h-auto' />
        <img src='/assets/logos/PaperHarbor.svg' alt='Paper Harbor' class='w-1/6 h-auto' />
        <img src='/assets/logos/Coastline.svg' alt='Coastline' class='w-1/6 h-auto' />
        <img src='/assets/logos/Kettle.svg' alt='Kettle' class='w-1/6 h-auto' />
        <img src='/assets/logos/Nordvik.svg' alt='Nordvik' class='w-1/6 h-auto' />
        <img src='/assets/logos/Halden.svg' alt='Halden' class='w-1/6 h-auto' />
        <img src='/assets/logos/Lumen.svg' alt='Lumen' class='w-1/6 h-auto' />
        <img src='/assets/logos/PaperHarbor.svg' alt='Paper Harbor' class='w-1/6 h-auto' />
      </div>
    </div>
    <div
      class='col-start-1 mt-4 pt-4 col-end-13 flex justify-center space-x-2'
    >
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-yellow-400 hover:bg-yellow-500 transition-colors duration-100 py-2 px-5 rounded-md'
      >
        Call to action
      </button>
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-transparent border border-stone-200 hover:bg-stone-100 transition-colors duration-100 py-2 px-5 rounded-md'
      >
        Call to action
      </button>
    </div>
  </div>
</section>

<style>
  @keyframes slide {
    from {
      transform: translateX(-5%);
    }
    to {
      transform: translateX(-55%);
    }
  }

  .animate-slide {
    animation: 30s slide infinite linear;
  }
</style>
