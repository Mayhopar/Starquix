---
/**
 * @category Metrics
 * @theme classic
 * @name Metrics
 */
---
<section
  class='bg-stone-50 px-16 py-10 flex flex-col gap-8 h-min'
>
  <div
    class='order-first px-4 col-span-6 flex flex-col justify-center items-start gap-4'
  >
    <h2
      class='text-stone-800 font-sans text-3xl font-bold leading-none tracking-tight'
    >
      Showcase Your Growth with Real Metrics
    </h2>
    <p
      class='text-stone-500 font-sans text-base font-normal leading-6'
    >
      Highlight key performance stats effortlessly using our free Astro
      components styled with TailwindCSS. Customize and display impressive
      numbers to captivate your audience—all with no paywalls or demo
      restrictions.
    </p>
  </div>
  <div class='flex flex-row gap-8 py-6 text-center'>
    <div class='pl-4 flex-1'>
      <div
        class='pl-4 border-l border-sky-500 flex flex-col justify-start items-start'
      >
        <p
          class='text-4xl text-stone-800 font-semibold text-left'
        >
          -40%
        </p>
        <p
          class='mt-2 text-stone-500 text-base text-left'
        >
          Reduced costs
        </p>
      </div>
    </div>
    <div class='pl-4 flex-1'>
      <div
        class='pl-4 border-l border-sky-500 flex flex-col justify-start items-start'
      >
        <p
          class='text-4xl text-stone-800 font-semibold text-left'
        >
          99.9%
        </p>
        <p
          class='mt-2 text-stone-500 text-base text-left'
        >
          Uptime achieved
        </p>
      </div>
    </div>
  </div>
</section>
