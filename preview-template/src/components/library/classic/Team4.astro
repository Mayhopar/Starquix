          class='w-12 h-12 rounded-full mr-4'
          alt='Riley Thompson'
        />
        <div
          class='flex flex-col justify-between flex-grow'
        >
          <div>
            <p
              class='text-stone-800 font-semibold text-lg'
            >
              Riley Thompson
            </p>
            <p
              class='text-stone-500 text-base'
            >
              CEO, Starquix Inc.
            </p>
          </div>
          <a
