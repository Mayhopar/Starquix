---
/**
 * @category Team
 * @theme classic
 * @name Team3
 */
---
<section
  class='bg-stone-50 px-2 py-8 flex flex-col gap-4 sm:px-4 sm:py-12 sm:gap-8 md:px-8 md:py-16 lg:px-16 lg:py-10'
>
  <div class='px-0 sm:px-4'>
    <h2
      class='text-stone-800 font-sans text-2xl font-bold text-center leading-tight tracking-tight sm:text-3xl sm:leading-tight md:text-4xl md:leading-none md:tracking-[-0.02em] lg:text-5xl lg:leading-none lg:tracking-[-1.44px]'
    >
      Our Team
    </h2>
  </div>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-4 md:gap-x-8 md:gap-y-4'>
    <div class='p-2 sm:p-4'>
      <div
        class='bg-white flex flex-col sm:flex-row rounded-lg overflow-hidden'
      >
        <img
          src='/assets/userpics/userpic07.webp'
          class='w-full h-auto object-cover sm:w-1/2'
          alt='Riley Thompson'
        />
        <div
          class='flex flex-col justify-between w-full px-4 py-3 sm:w-1/2'
        >
          <div>
            <p
              class='text-stone-800 font-semibold text-base sm:text-lg'
            >
              Riley Thompson
            </p>
            <p
              class='text-stone-500 text-sm sm:text-base'
            >
              CEO, Starquix Inc.
            </p>
          </div>
          <a
            class='text-sky-500 text-sm sm:text-base'
            href='#'>@starquix</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div
        class='bg-white flex flex-row rounded-lg overflow-hidden'
      >
        <img
          src='/assets/userpics/userpic08.webp'
          class='w-1/2 h-auto object-cover'
          alt='Jordana Lee'
        />
        <div
          class='flex flex-col justify-between w-1/2 px-4 py-3'
        >
          <div>
            <p
              class='text-stone-800 font-semibold text-lg'
            >
              Jordana Lee
            </p>
            <p
              class='text-stone-500 text-base'
            >
              CMO, Starquix
            </p>
          </div>
          <a
            class='text-sky-500 text-base'
            href='#'>@starquix</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div
        class='bg-white flex flex-row rounded-lg overflow-hidden'
      >
        <img
          src='/assets/userpics/userpic09.webp'
          class='w-1/2 h-auto object-cover'
          alt='Avery Kim'
        />
        <div
          class='flex flex-col justify-between w-1/2 px-4 py-3'
        >
          <div>
            <p
              class='text-stone-800 font-semibold text-lg'
            >
              Avery Kim
            </p>
            <p
              class='text-stone-500 text-base'
            >
              CTO, Starquix Studios
            </p>
          </div>
          <a
            class='text-sky-500 text-base'
            href='#'>@starquix</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div
        class='bg-white flex flex-row rounded-lg overflow-hidden'
      >
        <img
          src='/assets/userpics/userpic10.webp'
          class='w-1/2 h-auto object-cover'
          alt='Casey Morgan'
        />
        <div
          class='flex flex-col justify-between w-1/2 px-4 py-3'
        >
          <div>
            <p
              class='text-stone-800 font-semibold text-lg'
            >
              Casey Morgan
            </p>
            <p
              class='text-stone-500 text-base'
            >
              CPO, Starquix Digital
            </p>
          </div>
          <a
            class='text-sky-500 text-base'
            href='#'>@starquix</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
