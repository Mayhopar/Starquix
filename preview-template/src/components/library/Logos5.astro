---
/**
 * @category Logos
 * @theme starquix
 * @name Logos5
 */
---
<section class='flex flex-col gap-12 bg-stone-50 px-4 py-20 md:gap-16 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <h2 class='m-0 max-w-[24ch] font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:text-[4rem] dark:text-stone-50'>Marketing teams at these companies edit their own pages. <span class='text-stone-500 dark:text-stone-400'>Developers review every change in Git.</span></h2>
  <div class='grid grid-cols-2 items-center gap-x-4 md:max-w-xl md:grid-cols-3 md:gap-x-6 xl:max-w-5xl xl:grid-cols-6'>
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/Halden.svg' alt='Halden' width='256' height='148' />
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Paper Harbor' width='256' height='148' />
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/Kettle.svg' alt='Kettle' width='256' height='148' />
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/Lumen.svg' alt='Lumen' width='256' height='148' />
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/Pellow.svg' alt='Pellow' width='256' height='148' />
    <img class='block h-auto w-full max-w-[9rem] dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Nordvik' width='256' height='148' />
  </div>
</section>
