---
/**
 * @category Metrics
 * @theme starquix
 * @name Metrics2
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-12 xl:grid-cols-12 xl:gap-8'>
    <div class='flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10 xl:col-span-4 xl:flex-col xl:items-start xl:justify-start xl:gap-6'>
      <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:text-[4rem] dark:text-stone-50'>Made for every screen</h2>
      <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty md:max-w-sm dark:text-stone-400'>Every section in the library is responsive and has a dark version. Change any of it per breakpoint in the Design panel.</p>
    </div>
    <div class='grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 xl:col-span-8'>
      <div class='flex flex-col gap-3 border-0 border-t border-solid border-stone-200 pt-6 dark:border-stone-700'>
        <p class='m-0 pb-3 font-sans text-6xl font-light leading-none tracking-[-0.05em] text-stone-900 md:text-7xl dark:text-stone-50'>34</p>
        <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Sections in the library</h3>
        <p class='m-0 font-sans text-base leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Headers, heroes, features, pricing tables, teams, FAQs and footers.</p>
      </div>
      <div class='flex flex-col gap-3 border-0 border-t border-solid border-stone-200 pt-6 dark:border-stone-700'>
        <p class='m-0 pb-3 font-sans text-6xl font-light leading-none tracking-[-0.05em] text-stone-900 md:text-7xl dark:text-stone-50'>6</p>
        <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Breakpoints per class</h3>
        <p class='m-0 font-sans text-base leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Base, sm, md, lg, xl and 2xl, each with its own value.</p>
      </div>
      <div class='flex flex-col gap-3 border-0 border-t border-solid border-stone-200 pt-6 dark:border-stone-700'>
        <p class='m-0 pb-3 font-sans text-6xl font-light leading-none tracking-[-0.05em] text-stone-900 md:text-7xl dark:text-stone-50'>2</p>
        <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Color schemes per section</h3>
        <p class='m-0 font-sans text-base leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Light and dark, following your visitor’s system setting.</p>
      </div>
    </div>
  </div>
</section>
