---
/**
 * @category Team
 * @theme starquix
 * @name Team2
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-12 xl:grid-cols-4 xl:gap-8'>
    <div class='flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10 xl:flex-col xl:items-start xl:justify-start xl:gap-6'>
      <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:text-[4rem] dark:text-stone-50'>Team</h2>
      <div class='flex flex-col items-start gap-3 md:max-w-sm'>
        <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Ten people in ten cities, working overlapping hours from Lisbon to Tallinn.</p>
        <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>See open roles</a>
      </div>
    </div>
    <div class='grid grid-cols-1 md:grid-cols-2 md:gap-x-10 xl:col-span-3 xl:gap-x-8'>
      <div class='flex flex-col'>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic01.webp' alt='Portrait of Ines Moreau' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Ines Moreau</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Founder, product</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Lisbon</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic02.webp' alt='Portrait of Oskar Lind' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Oskar Lind</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Canvas engineer</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Stockholm</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic03.webp' alt='Portrait of Rosa Bianchi' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Rosa Bianchi</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Design systems</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Milan</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic04.webp' alt='Portrait of Tobias Kern' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Tobias Kern</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Desktop app</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Vienna</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic05.webp' alt='Portrait of Amara Nwosu' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Amara Nwosu</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Product designer</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>London</p>
        </div>
      </div>
      <div class='flex flex-col'>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic06.webp' alt='Portrait of Jan Novák' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Jan Novák</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Astro runtime</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Prague</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic07.webp' alt='Portrait of Noor Haddad' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Noor Haddad</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Editor engineer</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Berlin</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic08.webp' alt='Portrait of Clara Jensen' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Clara Jensen</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Customer support</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Copenhagen</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic09.webp' alt='Portrait of Pablo Soto' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Pablo Soto</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Templates</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Valencia</p>
        </div>
        <div class='flex items-center gap-4 border-0 border-t border-solid border-stone-200 py-4 dark:border-stone-700'>
          <img class='block h-12 w-12 shrink-0 rounded-full object-cover' src='/assets/userpics/userpic10.webp' alt='Portrait of Yuki Tanaka' width='48' height='48' />
          <div class='flex min-w-0 flex-1 flex-col'>
            <p class='m-0 font-sans text-base font-semibold text-stone-900 dark:text-stone-50'>Yuki Tanaka</p>
            <p class='m-0 font-sans text-sm text-stone-600 dark:text-stone-400'>Documentation</p>
          </div>
          <p class='m-0 shrink-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Tallinn</p>
        </div>
      </div>
    </div>
  </div>
</section>
