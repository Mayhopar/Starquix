---
/**
 * @category Logos
 * @theme starquix
 * @name Logos
 */
---
<section class='bg-stone-50 px-4 py-12 md:px-10 md:py-16 xl:px-16 dark:bg-stone-900'>
  <div class='flex flex-col gap-4 border-0 border-t border-solid border-stone-200 pt-6 md:gap-6 md:pt-8 xl:flex-row xl:items-center xl:gap-10 dark:border-stone-700'>
    <p class='m-0 font-sans text-base text-stone-600 xl:w-48 xl:shrink-0 dark:text-stone-400'>Used by web teams at</p>
    <div class='grid grid-cols-2 items-center md:grid-cols-3 xl:flex-1 xl:grid-cols-6 xl:gap-x-2'>
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/Halden.svg' alt='Halden' width='256' height='148' />
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/Lumen.svg' alt='Lumen' width='256' height='148' />
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/Kettle.svg' alt='Kettle' width='256' height='148' />
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Paper Harbor' width='256' height='148' />
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/Coastline.svg' alt='Coastline' width='256' height='148' />
      <img class='block h-auto w-full max-w-[10rem] justify-self-center dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Nordvik' width='256' height='148' />
    </div>
  </div>
</section>
