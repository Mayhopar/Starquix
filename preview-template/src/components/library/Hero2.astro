---
/**
 * @category Hero
 * @theme starquix
 * @name Hero2
 */
---
<section class='bg-stone-50 px-4 pb-20 pt-12 md:px-10 md:pb-28 md:pt-16 xl:px-16 xl:pb-32 xl:pt-20 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-12 xl:grid-cols-12 xl:gap-8'>
    <div class='flex flex-col gap-10 md:gap-12 xl:col-span-7 xl:min-h-[38rem] xl:justify-between'>
      <h1 class='m-0 font-sans text-[3rem] font-semibold leading-[0.92] tracking-[-0.045em] text-stone-900 text-balance md:text-[5.5rem] xl:text-[8rem] dark:text-stone-50'>Design Astro sites on a canvas</h1>
      <div class='flex flex-col gap-6 md:max-w-xl'>
        <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Drag sections into place, edit text where it sits and set each breakpoint by eye. Every page stays a plain Astro file in a folder on your Mac.</p>
        <div class='flex flex-col gap-3 sm:flex-row'>
          <a href='#' class='inline-flex min-h-12 items-center justify-center rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Download for Mac</a>
          <a href='#' class='inline-flex min-h-12 items-center justify-center rounded-lg bg-stone-200 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-stone-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:bg-stone-700 dark:text-stone-50 dark:hover:bg-stone-600 dark:focus-visible:outline-stone-50'>Watch the tour</a>
        </div>
        <p class='m-0 font-sans text-sm text-stone-500 dark:text-stone-400'>Free for one site. Runs on macOS 14 or later.</p>
      </div>
    </div>
    <div class='relative xl:col-span-5'>
      <img class='block aspect-square h-auto w-full rounded-[1.25rem] object-cover md:aspect-[16/10] md:rounded-[2rem] xl:absolute xl:inset-0 xl:aspect-auto xl:h-full xl:object-[60%_50%]' src='/assets/images/content/components.webp' alt='A spacesuit glove holding up a button, a label and a file icon against a blue sky' width='1024' height='1024' />
    </div>
  </div>
</section>
