<section class='flex flex-col gap-8 bg-stone-50 px-4 py-20 md:gap-10 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-2 items-center gap-x-6 md:grid-cols-4 md:gap-x-10 md:gap-y-4'>
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Paper Harbor' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Halden.svg' alt='Halden' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Pellow.svg' alt='Pellow' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Nordvik' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Coastline.svg' alt='Coastline' width='256' height='148' />
