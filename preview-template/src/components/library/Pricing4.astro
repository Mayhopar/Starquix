---
/**
 * @category Pricing
 * @theme starquix
 * @name Pricing4
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-x-8 gap-y-12 md:gap-y-16 xl:grid-cols-12 xl:items-end'>
    <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:col-span-8 xl:text-[4rem] dark:text-stone-50'>One price for every site you build</h2>
    <div class='flex flex-col items-start gap-6 xl:col-span-4'>
      <div class='flex flex-col gap-2'>
        <p class='m-0 flex items-baseline gap-1 font-sans text-sm text-stone-500 dark:text-stone-400'><span class='text-2xl font-light text-stone-900 dark:text-stone-50'>$</span><span class='text-7xl font-light tracking-[-0.05em] text-stone-900 dark:text-stone-50'>12</span>&nbsp;per month</p>
        <p class='m-0 font-sans text-base leading-relaxed text-stone-600 dark:text-stone-400'>Or $120 a year, two months free.</p>
      </div>
      <a href='#' class='inline-flex min-h-12 items-center justify-center rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Start a project</a>
    </div>
    <div class='grid grid-cols-1 gap-x-8 gap-y-6 border-0 border-t border-solid border-stone-200 xl:col-span-12 xl:grid-cols-subgrid dark:border-stone-700'>
      <div class='flex flex-col gap-2 pt-3 xl:col-span-4'>
        <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>What every site gets</h3>
        <p class='m-0 font-sans text-sm leading-normal text-stone-500 dark:text-stone-400'>Prices in US dollars. Cancel any time.</p>
      </div>
      <ul class='m-0 grid list-none grid-cols-1 gap-x-8 p-0 md:grid-cols-2 xl:col-span-8'>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Unlimited sites</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Custom domains</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>90 days of version history</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Up to 3 editors</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>2,000 form submissions a month</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Plain Astro and Tailwind files</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Publish to Vercel or GitHub Pages</li>
        <li class='border-0 border-b border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Email support</li>
      </ul>
    </div>
  </div>
</section>
