---
/**
 * @category Pricing
 * @theme starquix
 * @name Pricing3
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='flex flex-col gap-12 md:gap-16'>
    <div class='grid grid-cols-1 gap-5 md:grid-cols-12 md:items-end md:gap-10'>
      <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:col-span-7 md:text-6xl xl:text-[4rem] dark:text-stone-50'>Free until you need your own domain</h2>
      <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty md:col-span-5 dark:text-stone-400'>Publish one site on a Starquix address at no cost. Pro adds custom domains, unlimited sites and 90 days of history.</p>
    </div>
    <div class='flex flex-col gap-6'>
      <div class='grid grid-cols-1 gap-4 md:grid-cols-2 md:grid-rows-[repeat(9,auto)] md:gap-x-4 md:gap-y-0 xl:grid-cols-12'>
        <div class='flex flex-col rounded-2xl p-6 ring-1 ring-stone-200 md:row-span-9 md:grid md:grid-rows-subgrid md:px-5 md:ring-0 xl:col-span-5 xl:px-6 dark:ring-stone-700'>
          <h3 class='m-0 flex min-h-8 items-center pb-5 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Personal</h3>
          <div class='flex flex-col gap-1 pb-5'>
            <p class='m-0 flex items-baseline gap-1 font-sans font-light text-stone-900 dark:text-stone-50'><span class='text-2xl'>$</span><span class='text-7xl tracking-[-0.05em]'>0</span></p>
            <p class='m-0 font-sans text-sm text-stone-500 dark:text-stone-400'>No card needed</p>
          </div>
          <p class='m-0 pb-6 font-sans text-base leading-relaxed text-stone-600 dark:text-stone-400'>For a personal site or a first try.</p>
          <a href='#' class='mb-8 inline-flex min-h-12 items-center justify-center rounded-lg md:justify-self-start bg-stone-200 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-stone-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:bg-stone-700 dark:text-stone-50 dark:hover:bg-stone-600 dark:focus-visible:outline-stone-50'>Start for free</a>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>1 site</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Starquix subdomain</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>7 days of history</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>100 form submissions a month</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Community support</p>
        </div>
        <div class='flex flex-col rounded-2xl bg-white p-6 shadow-[0_1px_2px_rgb(28_25_23/0.06),0_16px_40px_-16px_rgb(28_25_23/0.18)] ring-1 ring-stone-200 md:row-span-9 md:grid md:grid-rows-subgrid md:px-5 xl:col-span-7 xl:px-8 dark:bg-stone-800 dark:ring-stone-700'>
          <h3 class='m-0 flex min-h-8 items-center pb-5 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Pro</h3>
          <div class='flex items-start gap-6 pb-5'>
            <div class='flex flex-col gap-1'>
              <p class='m-0 flex items-baseline gap-1 font-sans font-light text-stone-900 dark:text-stone-50'><span class='text-2xl'>$</span><span class='text-7xl tracking-[-0.05em]'>12</span></p>
              <p class='m-0 font-sans text-sm text-stone-500 dark:text-stone-400'>per month</p>
            </div>
            <div class='flex flex-col gap-1 border-0 border-l border-solid border-stone-200 pl-6 dark:border-stone-700'>
              <p class='m-0 flex items-baseline gap-1 font-sans font-light text-stone-900 dark:text-stone-50'><span class='text-2xl'>$</span><span class='text-7xl tracking-[-0.05em]'>120</span></p>
              <p class='m-0 font-sans text-sm text-stone-500 text-balance dark:text-stone-400'>per year, two months free</p>
            </div>
          </div>
          <p class='m-0 pb-6 font-sans text-base leading-relaxed text-stone-600 dark:text-stone-400'>For freelancers publishing client sites.</p>
          <a href='#' class='mb-8 inline-flex min-h-12 items-center justify-center rounded-lg md:justify-self-start bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Start with Pro</a>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Unlimited sites</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Custom domains</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>90 days of history</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>2,000 form submissions a month</p>
          <p class='m-0 border-0 border-t border-solid border-stone-200 py-3 font-sans text-base text-stone-900 dark:border-stone-700 dark:text-stone-50'>Email support</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-x-3 md:flex-row md:flex-wrap md:items-center md:px-5 xl:px-6'>
        <p class='m-0 font-sans text-base leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Need more? Team plans for up to 10 people start at $39 a month.</p>
        <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Talk to us</a>
      </div>
    </div>
  </div>
</section>
