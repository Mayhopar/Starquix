---
const { title = 'Release fixture' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      @font-face { font-family: ReleaseFixture; src: url('/release-fixture.woff') format('woff'); }
    </style>
  </head>
  <body class="min-h-screen bg-white text-neutral-900">
    <slot />
  </body>
</html>
