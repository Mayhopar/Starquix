---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Release home">
  <main class="mx-auto max-w-3xl p-8">
    <h1 class="text-4xl font-semibold">Release fixture</h1>
    <p class="mt-4 text-lg">First editable paragraph</p>
    <p class="mt-4 text-lg">Second editable paragraph</p>
    <img data-src="/deferred.png" SRC="/original.png" alt="Release image" class="mt-4 h-24 w-24" />
    <a class="block mt-4" href="/nested/about/?view=release">Nested about</a>
    <a class="block mt-4" href="/posts/hello/">Hello post</a>
    <a class="block mt-4" href="/products/widget/">Release widget</a>
  </main>
</Layout>
