---
import Header from '../components/Header.astro';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900">
    <Header />
    <main class="mx-auto max-w-4xl p-8">
      <slot />
    </main>
    <footer class="p-4 text-sm">© Import Basic</footer>
  </body>
</html>
