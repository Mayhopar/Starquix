---
/**
 * sq-post-layout-v1 — how every post looks (Starquix). Yours to edit.
 * header: classic (Medium-like) · centered (Substack-like) · cover (image first).
 * Each piece shows only when it is switched on AND the post has the data;
 * a post can hide one with frontmatter (hideCover, hideAuthor, hideDate,
 * hideReadingTime, hideSubtitle: true).
 */
import '../components/sq/sq-utilities.css';
import '../styles/sq-variables.css';
import Header from '../components/Header.astro';

interface Props {
  post: { data?: Record<string, any>; body?: string };
  header?: 'classic' | 'centered' | 'cover';
  showSubtitle?: boolean;
  showAuthor?: boolean;
  showDate?: boolean;
  showReadingTime?: boolean;
  showCover?: boolean;
}

const {
  post,
  header = 'classic',
  showSubtitle = true,
  showAuthor = true,
  showDate = true,
  showReadingTime = true,
  showCover = true,
} = Astro.props;

const d = post?.data ?? {};
const pick = (...keys: string[]) => {
  for (const k of keys) {
    const v = d[k];
    if (v !== undefined && v !== null && v !== '') return v;
  }
  return undefined;
};
const hidden = (k: string) => d[k] === true;
const srcOf = (v: any): string | undefined => (typeof v === 'string' ? v : v?.src);

const rawTitle = pick('title');
const hasTitle = typeof rawTitle === 'string' && rawTitle.trim() !== '';
const title = hasTitle ? rawTitle : 'Untitled';
const subtitle = showSubtitle && !hidden('hideSubtitle') ? pick('description', 'subtitle', 'excerpt') : undefined;
const cover = showCover && !hidden('hideCover') ? srcOf(pick('image', 'cover', 'heroImage', 'thumbnail')) : undefined;
const author = showAuthor && !hidden('hideAuthor') ? pick('author') : undefined;
const authorName = typeof author === 'string' ? author : author?.name;
const authorAvatar = typeof author === 'object' ? srcOf(author?.avatar) : undefined;
const rawDate = showDate && !hidden('hideDate') ? pick('date', 'pubDate', 'publishDate') : undefined;
const date = rawDate ? new Date(rawDate) : null;
const dateText = date && !isNaN(date.getTime())
  ? date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;
const words = showReadingTime && !hidden('hideReadingTime')
  ? String(post?.body ?? '')
      .replace(/^(import|export)\s.*$/gm, ' ')
      .replace(/<[^>]*>/g, ' ')
      .split(/\s+/)
      .filter((w) => /[\p{L}\p{N}]/u.test(w)).length
  : 0;
const readingText = words ? `${Math.max(1, Math.round(words / 230))} min read` : null;
const meta = [dateText, readingText].filter(Boolean);
// No image → the cover header has nothing to lead with: classic instead.
const variant = header === 'cover' && !cover ? 'classic' : header;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="m-0">
    <Header />
    <article data-sq-post-layout={variant} dir="auto">
      {variant === 'cover' && cover && (
        <img src={cover} alt="" loading="eager" decoding="async" class="block relative left-1/2 -translate-x-1/2 w-screen max-w-none aspect-[16/9] sm:aspect-[21/9] max-h-[70vh] object-cover" />
      )}
      <header class:list={['mx-auto w-full max-w-[680px] px-5 sm:px-6 box-border', 'pt-10 sm:pt-16 pb-8 sm:pb-10', variant === 'centered' && 'text-center [&_.sq-meta]:justify-center']}>
        <h1 class:list={['text-[2rem] sm:text-[2.75rem] leading-[1.12] font-bold tracking-[-0.02em] [overflow-wrap:anywhere] m-0', !hasTitle && 'opacity-40']}>{title}</h1>
        {subtitle && <p class="mt-3 text-[1.25rem] sm:text-[1.375rem] leading-[1.4] opacity-70 [overflow-wrap:anywhere] m-0">{subtitle}</p>}
        {(authorName || meta.length > 0) && (
          <div class="sq-meta mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9375rem] leading-[1.4]">
            {authorAvatar && <img src={authorAvatar} alt="" class="h-10 w-10 rounded-full object-cover shrink-0" loading="eager" />}
            {authorName && <span class="font-medium">{authorName}</span>}
            {meta.map((m, i) => (
              <span class="inline-flex items-center gap-3 whitespace-nowrap">
                {(authorName || i > 0) && <span aria-hidden="true" class="opacity-40">·</span>}
                <span class="opacity-60">{m}</span>
              </span>
            ))}
          </div>
        )}
        {variant !== 'cover' && cover && (
          <img
            src={cover}
            alt=""
            loading="eager"
            decoding="async"
            class={variant === 'classic' ? 'block mt-8 sm:mt-10 aspect-[16/9] object-cover rounded-lg relative left-1/2 -translate-x-1/2 w-[min(64rem,calc(100vw-2.5rem))] max-w-none' : 'block mt-8 sm:mt-10 w-full aspect-[16/9] object-cover rounded-lg'}
          />
        )}
      </header>
      <div class="mx-auto w-full max-w-[680px] px-5 sm:px-6 box-border text-[1.125rem] md:text-[1.25rem] leading-[1.6] [overflow-wrap:break-word] pb-16 [&>:first-child]:mt-0 [&>:last-child]:mb-0 [&_p]:my-[1.4em] [&_h2]:text-[1.75rem] md:[&_h2]:text-[2rem] [&_h2]:leading-[1.2] [&_h2]:font-bold [&_h2]:tracking-[-0.015em] [&_h2]:mt-[1.8em] [&_h2]:mb-[0.4em] [&_h3]:text-[1.375rem] md:[&_h3]:text-[1.5rem] [&_h3]:leading-[1.3] [&_h3]:font-bold [&_h3]:mt-[1.6em] [&_h3]:mb-[0.3em] [&_h4]:text-[1.125rem] md:[&_h4]:text-[1.25rem] [&_h4]:font-bold [&_h4]:mt-[1.4em] [&_h4]:mb-[0.2em] [&_:is(ul,ol)]:my-[1.2em] [&_:is(ul,ol)]:pl-[1.5em] [&_ul]:list-disc [&_ol]:list-decimal [&_li]:my-[0.35em] [&_li]:pl-[0.2em] [&_li>:is(ul,ol)]:my-[0.2em] [&_li>p]:my-0 [&_blockquote]:my-[1.6em] [&_blockquote]:mx-0 [&_blockquote]:[border-left:3px_solid_color-mix(in_srgb,currentColor_20%,transparent)] [&_blockquote]:pl-[1.2em] [&_blockquote]:text-[1.1em] [&_blockquote]:italic [&_blockquote>p]:my-[0.6em] [&_a]:text-inherit [&_a]:underline [&_a]:underline-offset-[3px] [&_a]:decoration-[1px] [&_a]:decoration-[color:color-mix(in_srgb,currentColor_40%,transparent)] hover:[&_a]:decoration-current [&_strong]:font-semibold [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:px-[0.3em] [&_:not(pre)>code]:py-[0.1em] [&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-[color-mix(in_srgb,currentColor_8%,transparent)] [&_pre]:my-[1.6em] [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:p-4 [&_pre]:text-[0.85em] [&_pre]:leading-[1.55] [&_pre]:max-w-full [&_pre]:bg-[color-mix(in_srgb,currentColor_6%,transparent)] [&_:is(img,video)]:max-w-full [&_:is(img,video)]:h-auto [&_img]:rounded-md [&_figure]:my-[2em] [&_figcaption]:mt-3 [&_figcaption]:text-[0.875rem] [&_figcaption]:opacity-60 [&_figcaption]:text-center [&_hr]:my-[2.5em] [&_hr]:border-0 [&_hr]:h-auto [&_hr]:text-center [&_hr]:before:content-['•_•_•'] [&_hr]:before:tracking-[0.6em] [&_hr]:before:opacity-60 [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto [&_table]:border-collapse [&_table]:text-[0.9em] [&_:is(th,td)]:[border-bottom:1px_solid_color-mix(in_srgb,currentColor_15%,transparent)] [&_:is(th,td)]:px-3 [&_:is(th,td)]:py-2 [&_th]:text-left print:[&_[data-sq-stack]]:!bg-transparent">
        <slot />
      </div>
    </article>
  </body>
</html>
